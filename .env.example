# AGTAALY WhatsApp Agent environment variables

# AI Provider: "openai" or "local" (default: openai)
# When set to "openai", uses OpenAI embeddings and GPT-4o model
# When set to "local", uses BGE-M3 embeddings and Ollama Qwen3 model
# Note: Different providers use separate ChromaDB collections automatically to avoid
# embedding dimension mismatches (agtaaly-openai vs agtaaly-local).
AI_PROVIDER=openai

# OpenAI configuration (used when AI_PROVIDER=openai)
OPENAI_API_KEY=

# Ollama configuration (used when AI_PROVIDER=local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3

# Embedding model configuration
BGE_MODEL=BAAI/bge-m3
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# WhatsApp configuration
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
CHROMA_PERSIST_DIR=./chroma_db

# Server configuration
APP_HOST=0.0.0.0
APP_PORT=8000
TOP_K_RETRIEVAL=4
WHATSAPP_API_VERSION=v21.0

# Testing modes
MOCK_INGEST=false
MOCK_EMBEDDING_DIM=1536
MOCK_WHATSAPP_SEND=false
WHATSAPP_TEST_MODE=false
WHATSAPP_TEST_REPLY=AGTAALY test reply: WhatsApp connection is working.